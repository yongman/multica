+  @Test
+  public void gfmFractionalThresholdAllocatesEnoughHeightForTheLastLine() {
+    String markdown = String.join("", Collections.nCopies(48, "W"));
+    SpannableString source = render(markdown);
+    EnrichedMarkdownInternalText probe = view(source);
+    int threshold = -1;
+    for (int width = 160; width < 344; width++) {
+      int narrow = naturalHeight(probe, width);
+      if (narrow > naturalHeight(probe, width + 1)) {
+        threshold = width;
+        break;
+      }
+    }
+    assertTrue("Fixture must cross a line-wrap threshold within one pixel", threshold > 0);
+    int wideHeight = naturalHeight(probe, threshold + 1);
+    int allocatedHeight = measureGfm(markdown, threshold + 0.25f);
+    assertTrue("GFM measurement must use the narrower integer viewport", allocatedHeight > wideHeight);
+    EnrichedMarkdownInternalText view = view(source);
+    layout(view, threshold, allocatedHeight);
+    assertFullyVisible(view);
+  }

@@ -0,0 +1,90 @@
+package com.swmansion.enriched.markdown.views
+
+import android.content.Context
+import android.view.MotionEvent
+import android.view.ViewConfiguration
+import android.widget.HorizontalScrollView
+import kotlin.math.abs
+
+internal class OverflowHorizontalScrollView(context: Context) : HorizontalScrollView(context) {
+  private enum class Drag {
+    NONE,
+    PENDING,
+    HORIZONTAL,
+    VERTICAL,
+  }
+
+  private val touchSlop = ViewConfiguration.get(context).scaledTouchSlop
+  private var drag = Drag.NONE
+  private var pointerId = MotionEvent.INVALID_POINTER_ID
+  private var downX = 0f
+  private var downY = 0f
+
+  init {
+    isNestedScrollingEnabled = true
+  }
+
+  override fun dispatchTouchEvent(event: MotionEvent): Boolean {
+    when (event.actionMasked) {
+      MotionEvent.ACTION_DOWN -> {
+        drag = if (canScrollHorizontally(-1) || canScrollHorizontally(1)) Drag.PENDING else Drag.NONE
+        if (drag == Drag.PENDING) {
+          trackPointer(event, 0)
+          startNestedScroll(SCROLL_AXIS_VERTICAL)
+        }
+      }
+
+      MotionEvent.ACTION_POINTER_UP -> if (drag == Drag.PENDING) {
+        val liftedIndex = event.actionIndex
+        if (event.getPointerId(liftedIndex) == pointerId) {
+          trackPointer(event, if (liftedIndex == 0) 1 else 0)
+        }
+      }
+
+      MotionEvent.ACTION_MOVE -> if (drag == Drag.PENDING) {
+        val pointerIndex = event.findPointerIndex(pointerId)
+        if (pointerIndex >= 0) {
+          val distanceX = abs(event.getX(pointerIndex) - downX)
+          val distanceY = abs(event.getY(pointerIndex) - downY)
+          if (maxOf(distanceX, distanceY) > touchSlop) {
+            if (distanceX > distanceY) {
+              drag = Drag.HORIZONTAL
+              parent?.requestDisallowInterceptTouchEvent(true)
+            } else {
+              drag = Drag.VERTICAL
+              cancelPressedChild(event)
+              parent?.requestDisallowInterceptTouchEvent(false)
+            }
+            stopNestedScroll()
+          }
+        }
+      }
+
+      MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> stopNestedScroll()
+    }
+
+    return drag == Drag.VERTICAL || super.dispatchTouchEvent(event)
+  }
+
+  private fun trackPointer(event: MotionEvent, pointerIndex: Int) {
+    pointerId = event.getPointerId(pointerIndex)
+    downX = event.getX(pointerIndex)
+    downY = event.getY(pointerIndex)
+  }
+
+  private fun cancelPressedChild(event: MotionEvent) {
+    val cancel = MotionEvent.obtain(event)
+    try {
+      cancel.action = MotionEvent.ACTION_CANCEL
+      super.dispatchTouchEvent(cancel)
+    } finally {
+      cancel.recycle()
+    }
+  }
+
+  override fun onInterceptTouchEvent(event: MotionEvent): Boolean =
+    drag != Drag.NONE && super.onInterceptTouchEvent(event)
+
+  override fun onTouchEvent(event: MotionEvent): Boolean =
+    drag != Drag.NONE && super.onTouchEvent(event)
+}

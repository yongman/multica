@@ -0,0 +1,72 @@
+package com.swmansion.enriched.markdown.utils.text.extensions
+
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.TextPaint
+import android.text.style.AbsoluteSizeSpan
+import android.text.style.ForegroundColorSpan
+import android.text.style.LeadingMarginSpan
+import android.text.style.ReplacementSpan
+import com.swmansion.enriched.markdown.spans.InlineMathReplacement
+import kotlin.math.roundToInt
+
+/**
+ * A ReplacementSpan cannot wrap. Expose complete LaTeX source when its bitmap
+ * cannot fit even on a fresh line, keeping measurement and display identical.
+ * Work on a copy so a wider viewport can restore the original math bitmap.
+ */
+fun CharSequence.fitInlineMathToWidth(
+  width: Int,
+  paint: TextPaint,
+): CharSequence {
+  val original = this as? Spanned ?: return this
+  val spans =
+    original
+      .getSpans(0, length, ReplacementSpan::class.java)
+      .filter { it is InlineMathReplacement }
+      .sortedByDescending { original.getSpanStart(it) }
+  var fitted: SpannableStringBuilder? = null
+  for (span in spans) {
+    val start = original.getSpanStart(span)
+    val end = original.getSpanEnd(span)
+    val margin =
+      original
+        .getSpans(start, end, LeadingMarginSpan::class.java)
+        .sumOf { maxOf(it.getLeadingMargin(true), it.getLeadingMargin(false)) }
+    val availableWidth = (width - margin).coerceAtLeast(1)
+    if (span.getSize(paint, original, start, end, null) > availableWidth) {
+      val result = fitted ?: SpannableStringBuilder(original).also { fitted = it }
+      val source = (span as InlineMathReplacement).source
+      val sourceText = "\$${source.latex}\$"
+      // Replacing the entire placeholder removes exclusive spans on that
+      // range, including math-only list markers and paragraph line height.
+      val decorations =
+        result
+          .getSpans(start, end, Any::class.java)
+          .filter { it !== span && result.getSpanStart(it) == start && result.getSpanEnd(it) == end }
+          .map { it to result.getSpanFlags(it) }
+      result.removeSpan(span)
+      result.replace(start, end, sourceText)
+      for ((decoration, flags) in decorations) {
+        if (result.getSpanStart(decoration) < 0) {
+          result.setSpan(decoration, start, start + sourceText.length, flags)
+        }
+      }
+      // A math-only paragraph has no ordinary text run to supply its theme
+      // color or font size. Retain both explicitly in the readable fallback.
+      result.setSpan(
+        AbsoluteSizeSpan(source.fontSize.roundToInt()),
+        start,
+        start + sourceText.length,
+        Spanned.SPAN_EXCLUSIVE_EXCLUSIVE,
+      )
+      result.setSpan(
+        ForegroundColorSpan(source.color),
+        start,
+        start + sourceText.length,
+        Spanned.SPAN_EXCLUSIVE_EXCLUSIVE,
+      )
+    }
+  }
+  return fitted ?: this
+}

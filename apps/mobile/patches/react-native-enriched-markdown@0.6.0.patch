+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 32, manifest = Config.NONE)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+public class MarkdownWidthTest {
+  private final TextPaint paint = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+  private static final String LONG_TOKEN = new String(new char[160]).replace('\0', 'W');
+
+  @Before
+  public void setUp() {
+    DisplayMetricsHolder.setWindowDisplayMetrics(RuntimeEnvironment.getApplication().getResources().getDisplayMetrics());
+    DisplayMetricsHolder.setScreenDisplayMetrics(RuntimeEnvironment.getApplication().getResources().getDisplayMetrics());
+    paint.setTypeface(Typeface.DEFAULT);
+    paint.setTextSize(14);
+  }
+
+  @Test
+  public void fractionalConstraintsDoNotRoundTextPastTheViewport() throws Exception {
+    Pair<Long, StaticLayout> measured = measureWithLayout(240.25f, LONG_TOKEN);
+    assertEquals(240, measured.getSecond().getWidth());
+    assertTrue(YogaMeasureOutput.getWidth(measured.getFirst()) <= 240.25f);
+  }
+
+  @Test
+  public void fallbackAndCachedMeasurementsClampIndivisibleSpans() throws Exception {
+    SpannableString text = new SpannableString("formula");
+    text.setSpan(new ReplacementSpan() {
+      @Override
+      public int getSize(Paint p, CharSequence value, int start, int end, Paint.FontMetricsInt fm) {
+        return 900;
+      }
+
+      @Override
+      public void draw(Canvas c, CharSequence value, int start, int end, float x, int top, int y, int bottom, Paint p) {}
+    }, 0, text.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+
+    Method measure = MeasurementStore.class.getDeclaredMethod("measure", float.class, CharSequence.class, TextPaint.class);
+    measure.setAccessible(true);
+    long cached = (long) measure.invoke(MeasurementStore.INSTANCE, 240f, text, paint);
+    assertTrue(YogaMeasureOutput.getWidth(cached) <= 240f);
+    assertTrue(YogaMeasureOutput.getWidth(measureWithLayout(240f, text).getFirst()) <= 240f);
+  }
+
+  @Test
+  public void proseWrapsInRootAndIndentedReplyWidthsWithoutChangingText() {
+    for (int screenWidth : new int[] {320, 360, 412}) {
+      for (int replyIndent : new int[] {0, 24, 48}) {
+        int width = screenWidth - 68 - replyIndent;
+        assertWraps(width, new SpannableString("https://example.com/" + LONG_TOKEN + "/end"));
+        assertWraps(width, new SpannableString("/workspace/" + LONG_TOKEN + "/file.ts"));
+        assertWraps(width, new SpannableString(LONG_TOKEN));
+
+        SpannableString code = new SpannableString("中文 before " + LONG_TOKEN + " after 中文");
+        code.setSpan(new TypefaceSpan("monospace"), 10, 10 + LONG_TOKEN.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        assertWraps(width, code);
+
+        SpannableString heading = new SpannableString(LONG_TOKEN);
+        heading.setSpan(new RelativeSizeSpan(20f / 14f), 0, heading.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        heading.setSpan(new StyleSpan(Typeface.BOLD), 0, heading.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        assertWraps(width, heading);
+
+        SpannableString link = new SpannableString(LONG_TOKEN);
+        link.setSpan(new URLSpan("mention://member/unchanged"), 0, link.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        assertWraps(width, link);
+        assertEquals("mention://member/unchanged", link.getSpans(0, link.length(), URLSpan.class)[0].getURL());
+
+        SpannableString nested = new SpannableString("Nested quote and task list " + LONG_TOKEN);
+        nested.setSpan(new LeadingMarginSpan.Standard(3 * 16 + 19), 0, nested.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+        assertWraps(width, nested);
+      }
+    }
+  }
+
+  @Test
+  public void largeSelectableTextReflowsWhenTheViewportNarrows() {
+    EnrichedMarkdownInternalText view = new EnrichedMarkdownInternalText(RuntimeEnvironment.getApplication());
+    view.setTextSize(android.util.TypedValue.COMPLEX_UNIT_PX, 28);
+    view.setIsSelectable(true);
+    view.applyStyledText(new SpannableString(LONG_TOKEN));
+    layout(view, 344);
+    int originalLines = view.getLayout().getLineCount();
+    layout(view, 204);
+    assertTrue(view.getLayout().getLineCount() > originalLines);
+    assertEquals(LONG_TOKEN.length(), view.getLayout().getLineEnd(view.getLayout().getLineCount() - 1));
+    for (int line = 0; line < view.getLayout().getLineCount(); line++) {
+      assertTrue(view.getLayout().getLineRight(line) <= 204);
+    }
+  }
+
+  private void assertWraps(int width, SpannableString text) {
+    EnrichedMarkdownInternalText view = new EnrichedMarkdownInternalText(RuntimeEnvironment.getApplication());
+    view.setTextSize(android.util.TypedValue.COMPLEX_UNIT_PX, 14);
+    view.setIsSelectable(false);
+    view.applyStyledText(text);
+    layout(view, width);
+    android.text.Layout layout = view.getLayout();
+    assertTrue(layout.getLineCount() > 1);
+    assertEquals(text.toString(), view.getText().toString());
+    assertEquals(text.length(), layout.getLineEnd(layout.getLineCount() - 1));
+    for (int line = 0; line < layout.getLineCount(); line++) {
+      assertTrue("line " + line + " starts outside " + width, layout.getLineLeft(line) >= 0);
+      assertTrue("line " + line + " ends outside " + width, layout.getLineRight(line) <= width);
+    }
+  }
+
+  private void layout(View view, int width) {
+    view.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
+        View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+    view.layout(0, 0, width, view.getMeasuredHeight());
+  }
+
+  @SuppressWarnings("unchecked")
+  private Pair<Long, StaticLayout> measureWithLayout(float width, CharSequence text) throws Exception {
+    Method method = MeasurementStore.class.getDeclaredMethod("measureWithLayout", float.class, CharSequence.class, TextPaint.class);
+    method.setAccessible(true);
+    return (Pair<Long, StaticLayout>) method.invoke(MeasurementStore.INSTANCE, width, text, paint);
+  }
+}

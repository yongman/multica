+  @Test
+  public void tableCellMeasurementAndDisplayUseTheSameSourceFallback() throws Exception {
+    MarkdownASTNode math = ShadowParser.node(NodeType.LatexMathInline, longMath, Collections.emptyList());
+    MarkdownASTNode cell = ShadowParser.node(NodeType.TableCell, "", Collections.singletonList(math));
+    MarkdownASTNode row = ShadowParser.node(NodeType.TableRow, "", Collections.singletonList(cell));
+    MarkdownASTNode body = ShadowParser.node(NodeType.TableBody, "", Collections.singletonList(row));
+    MarkdownASTNode table = ShadowParser.node(NodeType.Table, "", Collections.singletonList(body));
+    StyleConfig config = new StyleConfig(styles(), context, false, 0);
+    int allocatedHeight = (int) Math.ceil(TableContainerView.Companion.measureTableNodeHeight(table, config, context));
+    SpannableString source = render("$" + longMath + "$");
+    seedMathBitmaps(source);
+    Class<?> backgroundClass = Class.forName("com.swmansion.enriched.markdown.views.TableContainerView$CellBackgroundView");
+    Constructor<?> backgroundConstructor = backgroundClass.getDeclaredConstructor(Context.class);
+    backgroundConstructor.setAccessible(true);
+    android.widget.FrameLayout background = (android.widget.FrameLayout) backgroundConstructor.newInstance(context);
+    Class<?> dataClass = Class.forName("com.swmansion.enriched.markdown.views.TableContainerView$TableCellData");
+    Constructor<?> dataConstructor = dataClass.getDeclaredConstructor(
+        SpannableString.class, String.class, String.class, boolean.class, android.text.Layout.Alignment.class);
+    dataConstructor.setAccessible(true);
+    Object data = dataConstructor.newInstance(source, longMath, "$" + longMath + "$", false, android.text.Layout.Alignment.ALIGN_NORMAL);

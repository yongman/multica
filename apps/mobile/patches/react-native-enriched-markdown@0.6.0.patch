+        "addTextToCell", backgroundClass, dataClass, float.class, float.class);
+    addCell.setAccessible(true);
+    addCell.invoke(new TableContainerView(context, config), background, data, 300f, (float) allocatedHeight);
+    TextView view = (TextView) background.getChildAt(0);
+    // A 900px formula hits the table's existing 300px column cap.
+    layout(view, 300, allocatedHeight);
+    assertEquals("$" + longMath + "$", view.getText().toString());
+    assertFullyVisible(view);
+  }
+
+  @Test
+  public void mathOnlySourceRetainsItsThemeColorAndScaledFontSize() throws Exception {
+    SpannableString source = new SpannableString("\uFFFC");
+    source.setSpan(new MathInlineSpan(context, longMath, 28, Color.WHITE),
+        0, 1, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+    seedMathBitmaps(source);
+    EnrichedMarkdownInternalText view = view(source);
+    layout(view, 252, 500);
+    assertEquals("$" + longMath + "$", view.getText().toString());
+    Spanned fallback = (Spanned) view.getText();
+    assertEquals(Color.WHITE, fallback.getSpans(0, view.length(), ForegroundColorSpan.class)[0].getForegroundColor());
+    assertEquals(28, fallback.getSpans(0, view.length(), AbsoluteSizeSpan.class)[0].getSize());
+    assertFullyVisible(view);
+  }
+
+  private int measureGfm(String markdown, float width) {
+    JavaOnlyMap props = JavaOnlyMap.of("markdown", markdown, "markdownStyle", styles(),
+        "allowFontScaling", false, "md4cFlags", JavaOnlyMap.of("latexMath", true));
+    // Exercise the public Fabric measurement entry with GFM splitting enabled.
+    long size = MeasurementStore.INSTANCE.getMeasureById(context, null, width, 0,
+        YogaMeasureMode.UNDEFINED, props, true);
+    assertTrue(YogaMeasureOutput.getWidth(size) <= width);
+    assertTrue("The JNI parser boundary must be reached", ShadowParser.calls > 0);
+    assertFalse("The test must not silently use the non-GFM fallback",
+        ShadowLog.getLogsForTag("MeasurementStore").stream().anyMatch(log -> log.msg.contains("Split measurement failed")));
+    return (int) Math.ceil(YogaMeasureOutput.getHeight(size));
+  }
+
+  private SpannableString render(String markdown) {
+    Renderer renderer = new Renderer();
+    renderer.configure(new StyleConfig(styles(), context, false, 0), context);
+    return renderer.renderDocument(ShadowParser.ast(markdown), null, null);
+  }
+
+  private EnrichedMarkdownInternalText view(SpannableString text) {
+    EnrichedMarkdownInternalText view = new EnrichedMarkdownInternalText(context);
+    view.setTextSize(android.util.TypedValue.COMPLEX_UNIT_PX, 14);
+    view.setTextColor(Color.BLACK);
+    view.applyStyledText(text);
+    return view;
+  }
+
+  private int naturalHeight(View view, int width) {
+    view.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
+        View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+    return view.getMeasuredHeight();
+  }
+
+  private void layout(View view, int width, int allocatedHeight) {
+    if (view.getLayoutParams() == null) {
+      view.setLayoutParams(new android.view.ViewGroup.LayoutParams(
+          android.view.ViewGroup.LayoutParams.MATCH_PARENT, android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
+    }
+    view.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
+        View.MeasureSpec.makeMeasureSpec(allocatedHeight, View.MeasureSpec.EXACTLY));
+    view.layout(0, 0, width, allocatedHeight);
+  }
+
+  private void assertFullyVisible(TextView view) {
+    android.text.Layout layout = view.getLayout();
+    assertEquals(view.length(), layout.getLineEnd(layout.getLineCount() - 1));
+    assertTrue("Last line is outside the height returned to Fabric",
+        layout.getLineBottom(layout.getLineCount() - 1) <= view.getHeight());
+    for (int line = 0; line < layout.getLineCount(); line++) {
+      assertTrue(layout.getLineLeft(line) >= 0);
+      assertTrue("Line overflows the native text viewport", layout.getLineRight(line) <= view.getWidth());
+    }
+  }
+
+  private void seedMathBitmaps(SpannableString text) throws Exception {
+    for (MathInlineSpan span : text.getSpans(0, text.length(), MathInlineSpan.class)) {
+      Field latex = MathInlineSpan.class.getDeclaredField("latex");
+      latex.setAccessible(true);
+      int width = ((String) latex.get(span)).length() > 10 ? 900 : 60;
+      for (String name : Arrays.asList("cachedWidth", "mathAscent", "mathDescent", "cachedBitmap")) {
+        Field field = MathInlineSpan.class.getDeclaredField(name);
+        field.setAccessible(true);
+        if (name.equals("cachedWidth")) field.setInt(span, width);
+        else if (name.equals("mathAscent")) field.setFloat(span, 14);
+        else if (name.equals("mathDescent")) field.setFloat(span, 6);
+        else {
+          Bitmap bitmap = Bitmap.createBitmap(width, 20, Bitmap.Config.ARGB_8888);
+          bitmap.eraseColor(Color.BLACK);
+          field.set(span, bitmap);
+        }
+      }
+    }
+  }
+
+  private static JavaOnlyMap textStyle() {
+    return JavaOnlyMap.of("fontSize", 14.0, "fontFamily", "", "fontWeight", "normal",
+        "color", (double) Color.BLACK, "backgroundColor", 0.0, "borderColor", 0.0,
+        "lineHeight", 24.0, "marginTop", 0.0, "marginBottom", 0.0, "textAlign", "left");
+  }
+
+  private static JavaOnlyMap styles() {
+    JavaOnlyMap style = new JavaOnlyMap();
+    for (String key : Arrays.asList("paragraph", "h1", "h2", "h3", "h4", "h5", "h6",
+        "strong", "em", "strikethrough", "underline", "code", "inlineMath")) style.putMap(key, textStyle());
+    style.putMap("link", JavaOnlyMap.of("fontFamily", "", "color", (double) Color.BLACK, "underline", true, "backgroundColor", 0.0));
+    style.putMap("taskList", JavaOnlyMap.of("checkedColor", 0.0, "borderColor", 0.0,
+        "checkboxSize", 16.0, "checkboxBorderRadius", 2.0, "checkmarkColor", 0.0,
+        "checkedTextColor", 0.0, "checkedStrikethrough", false));
+    style.putMap("spoiler", JavaOnlyMap.of("color", 0.0,
+        "particles", JavaOnlyMap.of("density", 0.0, "speed", 0.0), "solid", JavaOnlyMap.of("borderRadius", 0.0)));
+    for (String key : Arrays.asList("superscript", "subscript")) {
+      style.putMap(key, JavaOnlyMap.of("fontScale", 1.0, "baselineOffsetScale", 0.0));
+    }
+    JavaOnlyMap table = textStyle();
+    for (String key : Arrays.asList("headerBackgroundColor", "rowEvenBackgroundColor", "rowOddBackgroundColor",
+        "borderWidth", "borderRadius", "cellPaddingHorizontal", "cellPaddingVertical")) table.putDouble(key, 0);
+    table.putDouble("headerTextColor", Color.BLACK);
+    table.putString("headerFontFamily", "");
+    style.putMap("table", table);
+    return style;
+  }
+
+  // Only the unavailable md4c JNI boundary is replaced. GFM segmentation,
+  // native span rendering, measurement, and TextView layout execute normally.
+  @Implements(value = Parser.class, isInAndroidSdk = false)
+  public static class ShadowParser {
+    static int calls;
+
+    @Implementation
+    protected static MarkdownASTNode nativeParseMarkdown(String markdown, Md4cFlags flags) {
+      calls++;
+      return ast(markdown);
+    }
+
+    static MarkdownASTNode ast(String markdown) {
+      List<MarkdownASTNode> children = new ArrayList<>();
+      int cursor = 0;
+      while (cursor < markdown.length()) {
+        int start = markdown.indexOf('$', cursor);
+        int end = start < 0 ? -1 : markdown.indexOf('$', start + 1);
+        if (end < 0) {
+          children.add(node(NodeType.Text, markdown.substring(cursor), Collections.emptyList()));
+          break;
+        }
+        if (start > cursor) children.add(node(NodeType.Text, markdown.substring(cursor, start), Collections.emptyList()));
+        children.add(node(NodeType.LatexMathInline, markdown.substring(start + 1, end), Collections.emptyList()));
+        cursor = end + 1;
+      }
+      return node(NodeType.Document, "", Collections.singletonList(node(NodeType.Paragraph, "", children)));
+    }
+
+    private static MarkdownASTNode node(NodeType type, String content, List<MarkdownASTNode> children) {
+      return new MarkdownASTNode(type, content, Collections.emptyMap(), children);
+    }
+  }
+
+  @Implements(value = MathMeasureHelper.class, isInAndroidSdk = false)
+  public static class ShadowMathMeasureHelper {
+    @Implementation
+    protected static List<MathMetrics> measureOnMainThread(Context context, List<MathMeasureRequest> requests) {
+      List<MathMetrics> result = new ArrayList<>();
+      for (MathMeasureRequest request : requests) {
+        result.add(new MathMetrics(request.getLatex().length() > 10 ? 900 : 60, 14, 6));
+      }
+      return result;
+    }
+  }
+}
